{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "command": ".cursor/hooks/preflight-reminder.sh",
        "matcher": "^(Write|StrReplace|Delete)$",
        "timeout": 5
      }
    ],
    "beforeShellExecution": [
      {
        "command": ".cursor/hooks/approve-risky-shell.sh",
        "timeout": 5
      }
    ]
  }
}
